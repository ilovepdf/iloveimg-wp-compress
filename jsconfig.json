{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "baseUrl": ".",
        "paths": {
            "@wordpress/*": [
                "./node_modules/@wordpress/*"
            ]
        },
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "dev/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "vendor"
    ]
}